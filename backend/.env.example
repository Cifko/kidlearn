PORT=3000
DATABASE_URL=sqlite://kidlearn.db?mode=rwc
JWT_SECRET=dev-secret-change-me
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
META_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
# Web client ID from Google Cloud Console (OAuth consent + credentials).
# Both the backend and the app need the same value.
GOOGLE_CLIENT_ID=
# Facebook Login from developers.facebook.com (app ID + app secret).
# The app needs the ID too (EXPO_PUBLIC_FACEBOOK_APP_ID); the secret
# stays here, never in the app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Log verbosity: error, warn, info (default), debug, trace.
RUST_LOG=info
