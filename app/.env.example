# API base URL for local development.
EXPO_PUBLIC_API_URL=http://localhost:3000
# On a physical phone, use your computer's LAN IP instead, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Web client ID from Google Cloud Console (same value as the backend's
# GOOGLE_CLIENT_ID). Empty = Google button stays disabled.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Facebook App ID from developers.facebook.com (same value as the backend's
# FACEBOOK_APP_ID; the secret stays backend-only). Empty = button disabled.
EXPO_PUBLIC_FACEBOOK_APP_ID=
# Set to false to hide the dev-login and Google buttons (Facebook stays).
# Defaults to visible when unset.
EXPO_PUBLIC_SHOW_EXTRA_LOGINS=true
